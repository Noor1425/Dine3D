# Browser-visible values only. Never put an RSA private key or API secret here.
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# PEM public key matching backend OFFLINE_ACCESS_PRIVATE_KEY. Use literal \n
# separators in hosted environment dashboards. The browser pins this key to
# validate a cached offline authority window after a cold start.
NEXT_PUBLIC_OFFLINE_ACCESS_PUBLIC_KEY=""
