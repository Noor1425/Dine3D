{
  "name": "dine3d-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "test": "jest --runInBand",
    "test:offline-browser": "node tests/browser/offline-production-acceptance.js",
    "start": "node scripts/serve-standalone.js",
